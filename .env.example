# Copy to .env.local and fill in. Required in production.

# Signs affiliate session cookies. Generate with: openssl rand -hex 32
# The app refuses to issue sessions in production without this.
SESSION_SECRET=

# Guards /admin?token=…
ADMIN_TOKEN=

# --- optional overrides (defaults live in src/lib/config.ts) ---
# AFFILIATE_COMMISSION_RATE=0.15
# AFFILIATE_DISCOUNT_RATE=0.10
# AFFILIATE_COOKIE_DAYS=30
# AFFILIATE_HOLD_DAYS=30
# AFFILIATE_PAYOUT_MINIMUM=5000
# FREE_SHIPPING_THRESHOLD=15000
# FLAT_SHIPPING=995
# SUPPORT_EMAIL=support@pepmarket.example

# Where the SQLite file lives (defaults to ./data/pepmarket.db)
# DATABASE_PATH=/var/lib/pepmarket/pepmarket.db
